# Backend API URL (read at RUNTIME via $env/dynamic/public, not baked into the
# build) — set this when running the container/server to point the frontend at
# your backend. Defaults to http://localhost:8000 if unset.
PUBLIC_API_URL=http://localhost:8000

# Backend URL for server-side operations (e.g., API client generation)
BACKEND_URL=http://localhost:8000

# Frontend version (displayed in footer)
# In production, this is set by the Docker build from the git tag
# In development, it defaults to 'dev'
PUBLIC_VERSION=dev

# Google OAuth (if using)
PUBLIC_GOOGLE_CLIENT_ID=

# Environment
NODE_ENV=development

# Identidade da instância: entra em <title>, og:site_name e no cartão do
# Twitter. Sem isso, o padrão continua sendo o do upstream.
PUBLIC_SITE_NAME=DuRock RJ
PUBLIC_TWITTER_SITE=@durockrj

# Idioma padrão da interface (src/lib/i18n.ts). O upstream traz 2465 chaves
# traduzidas para pt — é esta variável que põe a instância em português, no
# lugar de editar componente.
PUBLIC_DEFAULT_LANGUAGE=pt

# Idiomas que a instância oferece, separados por vírgula. Vazio ou ausente =
# todos os compilados (comportamento do upstream). Com um único idioma, o
# seletor do cabeçalho não é renderizado e `?lang=`, os cookies e o
# Accept-Language deixam de trocar a interface. Os catálogos dos outros idiomas
# CONTINUAM no repositório de propósito: apagá-los não economiza nada e foi
# metade do que criou a zona de conflito do fork antigo.
PUBLIC_AVAILABLE_LANGUAGES=pt

# IndexNow (SEO rapid re-crawl notifications to Bing/Yandex)
INDEXNOW_KEY=
INDEXNOW_TRIGGER_SECRET=

# Search Console verification
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
